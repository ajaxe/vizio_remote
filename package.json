{
  "name": "vizio-remote",
  "version": "1.0.0",
  "description": "Responsive offline-capable web remote control for Vizio SmartCast TVs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "docker:build": "docker build -t apogee-dev/vizio-remote:local ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@mdi/font": "^7.4.47",
    "dotenv": "^16.6.1",
    "hono": "^4.13.13",
    "ioredis": "^5.11.1",
    "vizio-smart-cast": "^1.4.0",
    "vue": "^3.5.43",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.4",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "vizio",
    "smartcast",
    "remote",
    "hono",
    "vue3",
    "vuetify",
    "pwa",
    "redis"
  ],
  "author": "asharma",
  "license": "MIT"
}
