{
  "name": "vizio-remote",
  "version": "1.0.0",
  "description": "Responsive offline-capable web remote control for Vizio SmartCast TVs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@mdi/font": "^7.4.47",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "vizio-smart-cast": "^1.4.0",
    "vue": "^3.5.13",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.2",
    "ioredis-mock": "^8.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "vizio",
    "smartcast",
    "remote",
    "hono",
    "vue3",
    "vuetify",
    "pwa",
    "redis"
  ],
  "author": "asharma",
  "license": "MIT"
}
